# ==========================================
# GestaMercado Backend - Variables de Entorno
# ==========================================

# Puerto del servidor
PORT=8080

# Conexión a Base de Datos (PostgreSQL con PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestamercadodb
DB_USER=gesta_app
DB_PASSWORD=gesta_app_password
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# Seguridad JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# Row Level Security (RLS)
RLS_HMAC_SECRET_HEX=262cd226022fdb0a61a34b0db8200fdb4fdf357065158b0033f3a086005e7977
RLS_SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001
RLS_ENABLED=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Fiscal
FISCAL_RECARGOS_CRON=0 0 2 * * ?
