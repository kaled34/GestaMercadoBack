    {
      "name": "01. Acceso, Autenticación Argon2id y Sesiones JWT",
      "item": [
        {
          "name": "01.1 Login Rechazado (Credenciales Inválidas - RFC 7807)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 401 Unauthorized ante contraseña incorrecta', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Respuesta cumple estándar RFC 7807 Problem Details', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('status', 401);",
                  "    pm.expect(jsonData).to.have.property('detail');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"ClaveIncorrecta#000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "01.2 Login Exitoso (Argon2id + Emisión JWT y Refresh Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK en Login', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Retorna accessToken, refreshToken, usuarioId y roles', function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(jsonData.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(jsonData.usuarioId).to.be.a('string');",
                  "    pm.expect(jsonData.roles).to.be.an('array').that.includes('ADMINISTRADOR');",
                  "});",
                  "pm.environment.set('access_token', jsonData.accessToken);",
                  "pm.environment.set('refresh_token', jsonData.refreshToken);",
                  "pm.environment.set('usuario_id', jsonData.usuarioId);",
                  "if (jsonData.municipioId) pm.environment.set('municipio_id', String(jsonData.municipioId));",
                  "if (jsonData.mercadoId) pm.environment.set('mercado_id', String(jsonData.mercadoId));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
