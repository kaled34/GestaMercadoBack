        {
          "name": "02.5 Crear Zona Interna de Mercado con Polígono PostGIS (/api/v1/zonas-mercado)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var suffix = Math.floor(1000 + Math.random() * 9000);",
                  "pm.environment.set('zona_nombre_temp', 'Zona Gastronómica Nave ' + suffix);",
                  "var idx = Math.floor(Math.random() * 900);",
                  "var col = idx % 30;",
                  "var row = Math.floor(idx / 30);",
                  "var lon1 = Number((-93.1169 + col * 0.00005).toFixed(6));",
                  "var lon2 = Number((lon1 + 0.00003).toFixed(6));",
                  "var lat1 = Number((16.7511 + row * 0.00005).toFixed(6));",
                  "var lat2 = Number((lat1 + 0.00003).toFixed(6));",
                  "pm.environment.set('z_lon1', lon1);",
                  "pm.environment.set('z_lon2', lon2);",
                  "pm.environment.set('z_lat1', lat1);",
                  "pm.environment.set('z_lat2', lat2);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201 Created al registrar zona de mercado', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Zona contiene ID y geometría GeoJSON', function () {",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.expect(jsonData.geom.type).to.eql('Polygon');",
                  "});",
                  "pm.environment.set('zona_id', String(jsonData.id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mercadoId\": {{mercado_id}},\n  \"nombre\": \"{{zona_nombre_temp}}\",\n  \"geom\": {\n    \"type\": \"Polygon\",\n    \"coordinates\": [\n      [\n        [{{z_lon1}}, {{z_lat1}}],\n        [{{z_lon2}}, {{z_lat1}}],\n        [{{z_lon2}}, {{z_lat2}}],\n        [{{z_lon1}}, {{z_lat2}}],\n        [{{z_lon1}}, {{z_lat1}}]\n      ]\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/zonas-mercado",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "zonas-mercado"]
            }
          }
        }
      ]
