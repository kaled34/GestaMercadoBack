    {
      "name": "04. Titularidad (Personas y Concesiones Comerciales)",
      "item": [
        {
          "name": "04.1 Registrar Persona Física Locataria (/api/v1/personas)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var digits = String(Math.floor(10 + Math.random() * 89));",
                  "var day = String(Math.floor(10 + Math.random() * 18));",
                  "var verifier = String(Math.floor(Math.random() * 10));",
                  "var root10 = 'GOMA8' + digits[0] + '05' + day;",
                  "var curp = root10 + 'HCSNRM0' + verifier;",
                  "var rfc = root10 + 'AB' + verifier;",
                  "pm.environment.set('curp_temp', curp);",
                  "pm.environment.set('rfc_temp', rfc);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201 Created al dar de alta persona física', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Persona registrada con CURP y RFC válidos', function () {",
                  "    pm.expect(jsonData.id).to.be.a('string');",
